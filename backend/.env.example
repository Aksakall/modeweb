NODE_ENV=development
PORT=4000
API_BASE_PATH=/api

CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modeweb?schema=public"

JWT_ACCESS_SECRET=dev-access-secret-change-before-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-before-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_NAME=modeweb_refresh_token
COOKIE_SECURE=false

ADMIN_EMAIL=admin@silasarioglu.com
ADMIN_PASSWORD=Admin123456!
ADMIN_FULL_NAME=Sıla Sarıoğlu Admin

