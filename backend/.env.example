NODE_ENV=development
PORT=4000
API_BASE_PATH=/api

# Comma separated frontend origins.
# Example: http://localhost:4173,https://silasarioglu.vercel.app
CORS_ORIGIN=http://localhost:4173,http://127.0.0.1:4173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modeweb?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=modeweb_refresh_token
COOKIE_SECURE=false
